# Copy this file to .env and fill in your values.

# Which LLM to use: gemini (free) | groq (free) | openrouter (free models) | ollama (local, free) | anthropic (paid)
LLM_PROVIDER=gemini

# Fill in the key for the provider you chose (you only need one)
# Gemini (free):   https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free):     https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter:      https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Claude (paid):   https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the provider's default model (e.g. gemini-3.8-flash, gemini-pro-latest)
# LLM_MODEL=

# ---- Rate-limit handling (optional) ----
# Backup models to switch to when the main one is rate-limited. If not set, the default is
# gemini-3.8-flash, plus any other provider above that you filled in a key for.
# LLM_FALLBACKS=gemini:gemini-3.8-flash,groq
# Minimum seconds between AI calls (default: 4 for gemini, 2 for groq)
# LLM_MIN_INTERVAL=4
# How much 10-K text to send per section (smaller = fewer tokens)
# MAX_SECTION_CHARS=9000

# The SEC requires a User-Agent with your name and email
SEC_USER_AGENT=Your Name your_email@example.com
